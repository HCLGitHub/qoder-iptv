{
  "name": "webos-iptv-player",
  "version": "1.1.48",
  "description": "Open-source M3U/IPTV player for LG webOS TV",
  "type": "module",
  "scripts": {
    "gen-icons": "node scripts/gen-icons.mjs",
    "predev": "node scripts/gen-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-icons.mjs",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "package": "npm run build && ares-package dist -o .",
    "install-tv": "ares-install --device tv ./com.qoder.iptv_1.1.48_all.ipk",
    "launch-tv": "ares-launch --device tv com.qoder.iptv",
    "test": "node --test scripts/test-i18n.mjs scripts/test-epg-store.mjs scripts/test-range-load.mjs scripts/test-source-manager.mjs scripts/test-startup.mjs scripts/test-warm-gate.mjs scripts/test-dev-proxy.mjs"
  },
  "dependencies": {
    "hls.js": "^1.5.13"
  },
  "devDependencies": {
    "@webos-tools/cli": "^3.2.6",
    "vite": "^5.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HCLGitHub/qoder-iptv.git"
  }
}
